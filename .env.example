# Local PostgreSQL. Use a dedicated login for the workers once provisioned.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=channel_scout
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# YouTube and Sheets
YOUTUBE_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# Drafting. Set MODEL_PROVIDER to groq or ollama.
MODEL_PROVIDER=groq
MODEL_NAME=openai/gpt-oss-20b
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Sender job only. Default to dry run.
OUTREACH_DRY_RUN=true
OUTREACH_APPROVER_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

