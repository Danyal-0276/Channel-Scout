# Local PostgreSQL. Use a dedicated login for the workers once provisioned.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=channel_scout
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_MIGRATION_USER=
POSTGRES_MIGRATION_PASSWORD=

# YouTube and Sheets
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_BUDGET=90
YOUTUBE_GENERAL_BUDGET=9000
ENABLE_ACTIVITY_CLASSIFICATION=false
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# Drafting. Set MODEL_PROVIDER to groq or ollama.
MODEL_PROVIDER=groq
MODEL_NAME=openai/gpt-oss-20b
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FALLBACK_ENABLED=false
OLLAMA_FALLBACK_MODEL=qwen3.5:4b
CHANNELSCOUT_OFFER=
CHANNELSCOUT_CONTACT_DOMAINS=
CHANNELSCOUT_BATCH_LIMIT=10

# Sender job only. Default to dry run.
OUTREACH_DRY_RUN=true
OUTREACH_DAILY_CAP=5
OUTREACH_APPROVAL_DAYS=7
GMAIL_SENDER_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

